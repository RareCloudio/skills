# restic-backup.env.example: settings for restic-backup, read by restic-backup-<APP>.service.
#
# Copy to /etc/restic-backup/<APP>.env, owned by root with mode 0600: it holds the storage keys.
# The same file loads in a shell for manual restic commands: set -a; . /etc/restic-backup/<APP>.env
# Placeholders, with the sample values the template is checked with:
#   <APP>               short name of the app (sample: shop)
#   <S3_ENDPOINT>       host name of the S3-compatible storage (sample: s3.example.com)
#   <BUCKET>            bucket for backups, not used for anything else (sample: shop-backups)
#   <HOST>              this server's name, so several servers can share a bucket (sample: web-01)
#   <ACCESS_KEY_ID>     access key limited to that bucket (sample: EXAMPLEKEYID)
#   <SECRET_ACCESS_KEY> its secret, from the storage provider's console (sample: examplesecret)
#   <DB_NAME>           the database to dump; for the Compose template, its POSTGRES_DB (sample: app)
#   <DB_USER>           the user to dump as; for the Compose template, its POSTGRES_USER (sample: app)
#   <REGION>            only if the provider asks for one (sample: us-east-1)
#   <MONITOR_HOST>, <CHECK_ID>  your uptime monitor's check-in URL (sample: monitor.example.com, abc123)

RESTIC_REPOSITORY=s3:https://<S3_ENDPOINT>/<BUCKET>/<HOST>
# One line, made once with: openssl rand -base64 32 > /etc/restic-backup/<APP>.password
# Without it the backups cannot be read by anyone, you included: keep a copy off this server.
RESTIC_PASSWORD_FILE=/etc/restic-backup/<APP>.password
AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
# Some providers want their region name as well:
# AWS_DEFAULT_REGION=<REGION>

BACKUP_TAG=<APP>
# What to back up besides the database dump. For the Compose layout of
# references/first-deploy.md, the app folder with its compose.yaml and .env: "/srv/<APP>".
# Without containers (references/systemd.md), the data and the settings:
# "/var/lib/<APP> /etc/<APP>". Every path must exist, or the run stops.
BACKUP_PATHS="/srv/<APP>"
DUMP_DIR=/var/backups/<APP>

# postgres, mysql (MySQL or MariaDB), sqlite or none
DB_KIND=postgres
DB_NAME=<DB_NAME>
# Set both when the database runs in a container: its container name, and the user it was
# created with (POSTGRES_USER), which the official image makes its only role.
# DB_CONTAINER=<APP>-db-1
# DB_USER=<DB_USER>
# For sqlite, the database file as seen from the host:
# SQLITE_PATH=/srv/<APP>/data/app.db

KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# Read back a share of the stored data on each run, to catch damage in the storage:
# CHECK_READ_DATA_SUBSET=5%
# A check-in URL from an uptime monitor that alerts when no check-in arrives in time:
# HEALTHCHECK_URL=https://<MONITOR_HOST>/ping/<CHECK_ID>
