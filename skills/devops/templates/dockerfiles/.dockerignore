# Keeps the build context small and keeps secrets and local state out of images.
# Copy to the project root as `.dockerignore`. No placeholders. Remove a line when the build
# really needs that path (a committed `build/` folder of sources, for example).

# Version control and secrets: an image is pushed and pulled; a secret copied in is shipped.
.git
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output: rebuilt inside the image for its own OS and architecture.
node_modules
.venv
venv
__pycache__
*.pyc
dist
build
.next
coverage

# Local state and editor files.
*.log
.DS_Store
.idea
.vscode

# Container files themselves: editing them should not invalidate the `COPY . .` layer.
Dockerfile
.dockerignore
compose*.yaml
docker-compose*.yml
